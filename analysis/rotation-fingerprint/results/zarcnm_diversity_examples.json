 "selection_rule": "Rule: 300 m blocks of the analysis grid that are entirely cropland and classified in 2023-2025; for each diversity level 3, 2, 1 (2023-2025, block majority), the purest block (mean share of the yearly majority class, 2020-2026), at least 5 km from the blocks already chosen; if a level has no block, the purest block with a new 2020-2026 majority sequence. Chosen to show one example per level, not at random.",
 "codes": {
  "T": "wheat-like winter cereal",
  "C": "winter cover crop",
  "P": "fallow (no green winter)",
  "O": "other",
  "-": "not classified"
 },
 "diversity_rule": {
  "source": "IN SPA/MAPA n. 2/2025, Annex, Table 1, indicator 6 (diversity of crops in the last three agricultural years) and item 2.4",
  "level_1": "requirements of the other levels not met",
  "level_2": "at least 4 crops, with at least 2 species and 2 botanical families",
  "level_3": "at least 6 crops, with at least 2 species and 2 botanical families, and 1 cover crop for more than 4 months OR 3 cover crops (single or mixed) for more than 45 days each",
  "level_4": "at least 6 crops, with at least 4 species and 2 botanical families, and 1 cover crop for more than 4 months AND 2 cover crops (single or mixed) for more than 45 days each",
  "applied_here": {
   "crops": "3 summer crops (one per agricultural year, assumed soybean, not classified) + every winter pixel-year with a green cycle (T, C or O)",
   "species_and_families": "any winter crop -> 2 species and 2 families (soybean, Fabaceae + a winter grass, Poaceae). 4 species cannot be counted from NDVI, so level 4 is never assigned: 'level 4 possible' flags pixels whose cover durations meet level 4, pending the species declared by the farmer",
   "cover_duration": "green-up to end of canopy in half-months: >= 3 (45.7 d) counts as 'more than 45 days', >= 8 (121.8 d) as 'more than 4 months'; covers green on 1 April give a lower bound",
   "window": "last three complete winters before the 2026/27 soybean (2023-2025); 2024-2026 also shown (2026 imagery to 2 November, the last granule on the server at the run)"
  }
 },
